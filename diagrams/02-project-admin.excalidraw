    {"type":"text","id":"a_gw_vlt_l","x":1120,"y":608,"width":60,"height":16,"text":"WIF","originalText":"WIF","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1141,"version":1,"versionNonce":1141,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

    {"type":"text","id":"projnote","x":205,"y":822,"width":1000,"height":36,"text":"A project dependency such as the dev database is federated into the gateway as a per-project\nvirtual server; only that project's scoped token can reach it.","originalText":"A project dependency such as the dev database is federated into the gateway as a per-project\nvirtual server; only that project's scoped token can reach it.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2021,"version":1,"versionNonce":2021,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

    {"type":"text","id":"seclbl","x":120,"y":895,"width":600,"height":26,"text":"Security at the project layer","originalText":"Security at the project layer","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2030,"version":1,"versionNonce":2030,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"ellipse","id":"sd1","x":126,"y":941,"width":12,"height":12,"strokeColor":"#1e40af","backgroundColor":"#1e40af","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2031,"version":1,"versionNonce":2031,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"s1","x":150,"y":935,"width":1240,"height":20,"text":"Tenant isolation by construction — each project gets its own Boundary scope, Nomad namespace, and Vault path prefix; one project cannot see another's.","originalText":"Tenant isolation by construction — each project gets its own Boundary scope, Nomad namespace, and Vault path prefix; one project cannot see another's.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2032,"version":1,"versionNonce":2032,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"ellipse","id":"sd2","x":126,"y":976,"width":12,"height":12,"strokeColor":"#1e40af","backgroundColor":"#1e40af","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2033,"version":1,"versionNonce":2033,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"s2","x":150,"y":970,"width":1240,"height":20,"text":"Dynamic, short-lived DB credentials — a Vault role mints auto-expiring read-only credentials; no static database password exists.","originalText":"Dynamic, short-lived DB credentials — a Vault role mints auto-expiring read-only credentials; no static database password exists.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2034,"version":1,"versionNonce":2034,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"ellipse","id":"sd3","x":126,"y":1011,"width":12,"height":12,"strokeColor":"#1e40af","backgroundColor":"#1e40af","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2035,"version":1,"versionNonce":2035,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"s3","x":150,"y":1005,"width":1240,"height":20,"text":"Scoped AI / MCP access — project data is exposed only as a per-project virtual MCP server, reachable solely with that project's token.","originalText":"Scoped AI / MCP access — project data is exposed only as a per-project virtual MCP server, reachable solely with that project's token.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2036,"version":1,"versionNonce":2036,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"ellipse","id":"sd4","x":126,"y":1046,"width":12,"height":12,"strokeColor":"#1e40af","backgroundColor":"#1e40af","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2037,"version":1,"versionNonce":2037,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"s4","x":150,"y":1040,"width":1240,"height":20,"text":"Least-privilege brokering — Boundary brokers into this project's scope alone; SSH CA, Git tokens, and secrets sit under per-project Vault paths.","originalText":"Least-privilege brokering — Boundary brokers into this project's scope alone; SSH CA, Git tokens, and secrets sit under per-project Vault paths.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2038,"version":1,"versionNonce":2038,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25}
