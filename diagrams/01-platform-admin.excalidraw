    {"type":"text","id":"s4","x":150,"y":1105,"width":1240,"height":20,"text":"Isolation-ready — per-project Vault paths, Nomad namespaces, and Boundary scopes layer onto this foundation.","originalText":"Isolation-ready — per-project Vault paths, Nomad namespaces, and Boundary scopes layer onto this foundation.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1168,"version":1,"versionNonce":1168,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25}
