    {"type":"text","id":"s1","x":150,"y":1000,"width":1240,"height":20,"text":"No standing credentials — workloads obtain short-lived credentials from Vault via workload-identity federation; nothing static is baked into jobs.","originalText":"No standing credentials — workloads obtain short-lived credentials from Vault via workload-identity federation; nothing static is baked into jobs.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1162,"version":1,"versionNonce":1162,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"ellipse","id":"sd2","x":126,"y":1041,"width":12,"height":12,"strokeColor":"#1e40af","backgroundColor":"#1e40af","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1163,"version":1,"versionNonce":1163,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"s2","x":150,"y":1035,"width":1240,"height":20,"text":"Single identity-aware entry — every human session is brokered through Boundary and bound to a named IBM Verify identity.","originalText":"Single identity-aware entry — every human session is brokered through Boundary and bound to a named IBM Verify identity.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1164,"version":1,"versionNonce":1164,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"ellipse","id":"sd3","x":126,"y":1076,"width":12,"height":12,"strokeColor":"#1e40af","backgroundColor":"#1e40af","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1165,"version":1,"versionNonce":1165,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"s3","x":150,"y":1070,"width":1240,"height":20,"text":"Centralized AI / MCP control — the gateway is the one policy point governing which MCP servers, tools, and LLMs a workload may reach.","originalText":"Centralized AI / MCP control — the gateway is the one policy point governing which MCP servers, tools, and LLMs a workload may reach.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1166,"version":1,"versionNonce":1166,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
