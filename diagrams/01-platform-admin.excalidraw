    {"type":"text","id":"seclbl","x":120,"y":960,"width":600,"height":26,"text":"Security at the foundation layer","originalText":"Security at the foundation layer","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1160,"version":1,"versionNonce":1160,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
