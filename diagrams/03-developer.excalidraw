    {"type":"text","id":"a_gw_vlt_l","x":1120,"y":1013,"width":60,"height":16,"text":"WIF","originalText":"WIF","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1141,"version":1,"versionNonce":1141,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

    {"type":"text","id":"projnote","x":205,"y":1227,"width":1000,"height":36,"text":"A project dependency such as the dev database is federated into the gateway as a per-project\nvirtual server; only that project's scoped token can reach it.","originalText":"A project dependency such as the dev database is federated into the gateway as a per-project\nvirtual server; only that project's scoped token can reach it.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2021,"version":1,"versionNonce":2021,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

    {"type":"text","id":"seclbl","x":120,"y":1300,"width":600,"height":26,"text":"Security in the AI-agentic sandbox","originalText":"Security in the AI-agentic sandbox","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3030,"version":1,"versionNonce":3030,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"ellipse","id":"sd1","x":126,"y":1346,"width":12,"height":12,"strokeColor":"#1e40af","backgroundColor":"#1e40af","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3031,"version":1,"versionNonce":3031,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"s1","x":150,"y":1340,"width":1240,"height":20,"text":"The coding agent runs centrally, not on the laptop — the sandbox is a Nomad workload in the cluster, isolated from other projects.","originalText":"The coding agent runs centrally, not on the laptop — the sandbox is a Nomad workload in the cluster, isolated from other projects.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3032,"version":1,"versionNonce":3032,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"ellipse","id":"sd2","x":126,"y":1381,"width":12,"height":12,"strokeColor":"#1e40af","backgroundColor":"#1e40af","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3033,"version":1,"versionNonce":3033,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"s2","x":150,"y":1375,"width":1240,"height":20,"text":"No standing credentials — access is a Boundary session with a short-lived, Vault-signed SSH certificate; secrets live only in tmpfs.","originalText":"No standing credentials — access is a Boundary session with a short-lived, Vault-signed SSH certificate; secrets live only in tmpfs.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3034,"version":1,"versionNonce":3034,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"ellipse","id":"sd3","x":126,"y":1416,"width":12,"height":12,"strokeColor":"#1e40af","backgroundColor":"#1e40af","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3035,"version":1,"versionNonce":3035,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"s3","x":150,"y":1410,"width":1240,"height":20,"text":"AI / MCP access gated centrally — the agent reaches its LLM and only its project's virtual MCP server, per organization policy.","originalText":"AI / MCP access gated centrally — the agent reaches its LLM and only its project's virtual MCP server, per organization policy.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3036,"version":1,"versionNonce":3036,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"ellipse","id":"sd4","x":126,"y":1451,"width":12,"height":12,"strokeColor":"#1e40af","backgroundColor":"#1e40af","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3037,"version":1,"versionNonce":3037,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"s4","x":150,"y":1445,"width":1240,"height":20,"text":"Per-developer isolation — identity-bound authorization grants each developer exactly one workspace target; nothing else is reachable.","originalText":"Per-developer isolation — identity-bound authorization grants each developer exactly one workspace target; nothing else is reachable.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3038,"version":1,"versionNonce":3038,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25}
