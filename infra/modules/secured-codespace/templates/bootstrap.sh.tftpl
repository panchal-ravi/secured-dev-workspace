#!/bin/bash
set -euxo pipefail
exec > >(tee -a /var/log/boundary-bootstrap.log) 2>&1

echo "=== Boundary all-in-one bootstrap starting ==="

export DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# 1. Local PostgreSQL (Boundary controller state store)
# ---------------------------------------------------------------------------
apt-get update
apt-get install -y postgresql
systemctl enable --now postgresql

echo "Waiting for PostgreSQL to accept connections..."
until pg_isready -h 127.0.0.1 -p 5432; do sleep 2; done

# Create the boundary role + database (idempotent).
sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='boundary'" | grep -q 1 \
  || sudo -u postgres psql -c "CREATE ROLE boundary WITH LOGIN PASSWORD '${db_password}';"
sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='boundary'" | grep -q 1 \
  || sudo -u postgres psql -c "CREATE DATABASE boundary OWNER boundary;"

# ---------------------------------------------------------------------------
# 2. Write Boundary config, TLS material, license and the systemd unit
# ---------------------------------------------------------------------------
mkdir -p /etc/boundary.d/tls

cat > /etc/boundary.d/boundary.hcl <<-'BOUNDARY_HCL'
${boundary_config}
BOUNDARY_HCL

cat > /etc/boundary.d/tls/boundary.crt <<-'BOUNDARY_CRT'
${boundary_crt}
BOUNDARY_CRT

cat > /etc/boundary.d/tls/boundary.key <<-'BOUNDARY_KEY'
${boundary_key}
BOUNDARY_KEY

cat > /etc/boundary.d/boundary_license.hclic <<-'BOUNDARY_LICENSE'
${boundary_license}
BOUNDARY_LICENSE

cat > /etc/systemd/system/boundary.service <<-'BOUNDARY_SERVICE'
${boundary_service}
BOUNDARY_SERVICE

chown -R boundary:boundary /etc/boundary.d
chmod 600 /etc/boundary.d/tls/boundary.key

# ---------------------------------------------------------------------------
# 3. Initialize the Boundary database (once). Skip every convenience resource —
#    we create the auth method, admin, scopes and roles ourselves below so they
#    are configurable. This only sets up the schema + global scope/KMS.
# ---------------------------------------------------------------------------
if [ ! -f /home/ubuntu/boundary-init.json ]; then
  sudo -u boundary /usr/local/bin/boundary database init \
    -skip-auth-method-creation \
    -skip-scopes-creation \
    -skip-host-resources-creation \
    -skip-target-creation \
    -skip-initial-login-role-creation \
    -skip-initial-authenticated-user-role-creation \
    -config /etc/boundary.d/boundary.hcl -format json \
    > /home/ubuntu/boundary-init.json 2> /home/ubuntu/boundary-init.err || true
  chown ubuntu:ubuntu /home/ubuntu/boundary-init.json /home/ubuntu/boundary-init.err || true
fi

# ---------------------------------------------------------------------------
# 4. Start Boundary.
# ---------------------------------------------------------------------------
systemctl daemon-reload
systemctl enable --now boundary

# ---------------------------------------------------------------------------
# 5. Configure scopes / auth method / admin / roles via the recovery KMS
#    workflow (no login required — authenticates with the recovery AEAD key).
# ---------------------------------------------------------------------------
if [ ! -f /home/ubuntu/boundary-setup.json ]; then
  export BOUNDARY_ADDR="https://127.0.0.1:9200"
  export BOUNDARY_TLS_INSECURE=true
  RECOVERY=/etc/boundary.d/recovery.hcl

  cat > "$RECOVERY" <<'RECOVERY_HCL'
kms "aead" {
  purpose   = "recovery"
  aead_type = "aes-gcm"
  key       = "${recovery_key}"
  key_id    = "global_recovery"
}
RECOVERY_HCL
  chmod 600 "$RECOVERY"

  # Helper: every API call uses the recovery config and JSON output.
  bdy() { /usr/local/bin/boundary "$@" -recovery-config "$RECOVERY" -format json; }

  echo "Waiting for the Boundary controller API..."
  ready=0
  for _ in $(seq 1 120); do
    if bdy scopes list -scope-id global >/dev/null 2>&1; then ready=1; break; fi
    sleep 5
  done
  [ "$ready" = "1" ] || { echo "Boundary controller API did not become ready"; exit 1; }

  # Admin password (kept out of the xtrace log).
  set +x
  export BOUNDARY_ADMIN_PASSWORD='${admin_password}'
  set -x

  # Password auth method in the global scope, made the primary auth method.
  AM_ID=$(bdy auth-methods create password -scope-id global \
    -name "global-password" -description "Primary password auth method" | jq -r '.item.id')
  bdy scopes update -id global -primary-auth-method-id "$AM_ID"

  # Admin account + user, then bind the account to the user.
  ACCT_ID=$(bdy accounts create password -auth-method-id "$AM_ID" \
    -login-name "${admin_login_name}" -password env://BOUNDARY_ADMIN_PASSWORD | jq -r '.item.id')
  USER_ID=$(bdy users create -scope-id global \
    -name "${admin_login_name}" -description "Boundary administrator" | jq -r '.item.id')
  bdy users add-accounts -id "$USER_ID" -account "$ACCT_ID"

  # Org scope, then a project scope beneath it.
  ORG_ID=$(bdy scopes create -scope-id global \
    -name "${org_name}" -description "Org scope" | jq -r '.item.id')
  PROJECT_ID=$(bdy scopes create -scope-id "$ORG_ID" \
    -name "${project_name}" -description "Project scope" | jq -r '.item.id')

  # Admin role: full grants over global + every descendant scope, bound to the admin user.
  ROLE_ID=$(bdy roles create -scope-id global \
    -name "${admin_login_name}-admin" -description "Full administrator" | jq -r '.item.id')
  bdy roles add-grants -id "$ROLE_ID" -grant "ids=*;type=*;actions=*"
  bdy roles add-principals -id "$ROLE_ID" -principal "$USER_ID"
  bdy roles add-grant-scopes -id "$ROLE_ID" -grant-scope-id "this" -grant-scope-id "descendants"

  # Anonymous login role so unauthenticated users can reach the auth method.
  LOGIN_ROLE_ID=$(bdy roles create -scope-id global \
    -name "anon-login" -description "Allow anonymous users to authenticate" | jq -r '.item.id')
  bdy roles add-grant-scopes -id "$LOGIN_ROLE_ID" -grant-scope-id "this"
  bdy roles add-grants -id "$LOGIN_ROLE_ID" \
    -grant "ids=*;type=auth-method;actions=authenticate,list" \
    -grant "ids=*;type=scope;actions=list,no-op"
  bdy roles add-principals -id "$LOGIN_ROLE_ID" -principal "u_anon"

  set +x
  unset BOUNDARY_ADMIN_PASSWORD
  set -x

  # Record the generated IDs for Terraform outputs (no secrets in this file).
  cat > /home/ubuntu/boundary-setup.json <<SETUP_JSON
{
  "auth_method_id": "$AM_ID",
  "admin_login_name": "${admin_login_name}",
  "admin_user_id": "$USER_ID",
  "admin_role_id": "$ROLE_ID",
  "org_name": "${org_name}",
  "org_scope_id": "$ORG_ID",
  "project_name": "${project_name}",
  "project_scope_id": "$PROJECT_ID"
}
SETUP_JSON
  chown ubuntu:ubuntu /home/ubuntu/boundary-setup.json
fi

# ---------------------------------------------------------------------------
# 6. Signal readiness for the Terraform provisioner.
# ---------------------------------------------------------------------------
touch /home/ubuntu/.boundary-ready
chown ubuntu:ubuntu /home/ubuntu/.boundary-ready

echo "=== Boundary all-in-one bootstrap complete ==="
