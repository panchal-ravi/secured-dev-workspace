# ── Secrets & credentials ──────────────────────────────────────────────
.env
.env.*
*.pem
*_rsa
*_ed25519
# HashiCorp Enterprise license files
*.hclic
*.lic
# tfvars often carry secrets (this repo: boundary_admin_password).
# Track a sanitized terraform.tfvars.example instead. The trailing glob also
# covers backup variants (e.g. terraform.tfvars.bak).
*.tfvars*
!*.tfvars.example

# ── Terraform ──────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ── Packer ─────────────────────────────────────────────────────────────
packer_cache/
**/packer_cache/
*.box

# ── Runtime-generated material (SSH keys, DB-init / setup credentials) ──
generated/

# ── Local working docs (plan + phase specs; not committed) ─────────────
docs/

# ── Throwaway verification harness (not part of the real stack) ────────
infra/identity-test/

# ── OS / editor cruft ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
