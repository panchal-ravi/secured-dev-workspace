# ── Secrets & credentials ──────────────────────────────────────────────
.env
.env.*
*.pem
*_rsa
*_ed25519
# HashiCorp Enterprise license files
*.hclic
*.lic
# tfvars often carry secrets (this repo: boundary_admin_password).
# Track a sanitized terraform.tfvars.example instead. The trailing glob also
# covers backup variants (e.g. terraform.tfvars.bak).
*.tfvars*
!*.tfvars.example

# ── Terraform ──────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
# Saved plans embed resolved variable/secret values — never commit.
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc


# ── Packer ─────────────────────────────────────────────────────────────
packer_cache/
**/packer_cache/
*.box

# ── Runtime-generated material (SSH keys, DB-init / setup credentials) ──
generated/

# ── Local working docs (plan + phase specs; not committed) ─────────────
docs/
.claude/
CLAUDE.md
# ── Throwaway verification harness (not part of the real stack) ────────
terraform/infra/identity-test/

# ── IDIG working dir (may hold project secrets — never commit) ─────────
idig-projects/
scratch
AGENTIC-SANDBOX-REVIEW.md
demo/
samples/

# Frontend deps + build artifacts
portal/frontend/node_modules/
portal/backend/web/

# secured-ws helper build artifacts (binary; rebuilt by helper/macos/build.sh)
portal/backend/helper-dist/
portal/helper/macos/build/

# Local config / secrets (never commit)
*.env
.env
portal/backend/portal

skills-lock.json

# ── OS / editor cruft ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
.envrc