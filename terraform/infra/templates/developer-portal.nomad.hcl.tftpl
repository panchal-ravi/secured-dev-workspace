# Developer Portal jobspec (platform tier). Rendered by terraform/infra/
# developer-portal.tf templatefile(). consul-template "{{ ... }}" is left literal
# (a different delimiter from Terraform interpolation). Nomad runtime vars are
# escaped as $${...} so templatefile leaves them for Nomad to expand.
#
# Stateless single instance: no host volume. The portal terminates its own TLS on
# :8443 (self-signed cert from Vault KV) so the NLB stays a TCP pass-through and
# Secure cookies are honored. Privileged provisioning creds (Boundary admin,
# Nomad mgmt token) and the portal's own secrets come from Vault KV over WIF; the
# WIF Vault token itself is re-read from secrets/vault_token so rotation is picked up.
job "developer-portal" {
  namespace   = "${namespace}"
  datacenters = ["dc1"]
  type        = "service"

  group "portal" {
    count = 1

    network {
      port "https" {
        static = ${port}
        to     = ${port}
      }
    }

    task "portal" {
      driver = "docker"

      config {
        image      = "${image}"
        force_pull = true
        ports      = ["https"]
        # Share the host network namespace so the portal's outbound calls to
        # Boundary/Nomad/Vault on 127.0.0.1 reach the all-in-one node's services
        # (a bridged container's loopback is its own, not the host's), and so it
        # binds :8443 directly on the host for the NLB target group.
        network_mode = "host"
      }

      # WIF: exchange the Nomad task JWT for a short Vault token scoped to the
      # portal's own secret path (the infra-developer-portal role/policy).
      vault {
        role = "${wif_role}"
      }
%{ if enable_platform_admin ~}
      # Second workload identity for the project-deploy plane: the portal exchanges
      # this JWT (aud=vault-provisioner) at <project>/auth/jwt-nomad/login for a token
      # NATIVE to the target project namespace, then provisions blueprints with it —
      # no standing cross-namespace privilege. Written to secrets/nomad_vault_provisioner.jwt.
      identity {
        name = "vault_provisioner"
        aud  = ["vault-provisioner"]
        file = true
        ttl  = "1h"
      }
%{ endif ~}
%{ if enable_project_creator ~}
      # Third workload identity for the project-CREATE plane: exchanged at the
      # ROOT-namespace jwt-nomad backend (role project-creator) for a short-TTL token
      # that creates a project's Vault namespace + bootstraps its auth, then discards
      # it. Written to secrets/nomad_vault_creator.jwt.
      identity {
        name = "vault_creator"
        aud  = ["vault-creator"]
        file = true
        ttl  = "1h"
      }
%{ endif ~}

      # Privileged provisioning creds + the portal's own OIDC/session secrets, from
      # Vault KV. env=true sources them as environment; change_mode=restart so a
      # rotation restarts the portal. KV v2 ⇒ values are under .Data.data.*.
      template {
        destination = "secrets/portal.env"
        env         = true
        change_mode = "restart"
        data        = <<EOH
{{ with secret "${kv_path}" }}
PORTAL_OIDC_CLIENT_SECRET={{ .Data.data.oidc_client_secret }}
PORTAL_SESSION_SECRET={{ .Data.data.session_secret }}
PORTAL_BOUNDARY_LOGIN={{ .Data.data.boundary_login }}
PORTAL_BOUNDARY_PASSWORD={{ .Data.data.boundary_password }}
PORTAL_NOMAD_TOKEN={{ .Data.data.nomad_token }}
%{ if enable_platform_admin ~}
PORTAL_DB_DSN=postgres://portal:{{ .Data.data.pg_password }}@${db_host}/portal?sslmode=disable
%{ endif ~}
{{ end }}
EOH
      }

      # Server TLS material (multi-line PEM → files, not env).
      template {
        destination = "secrets/tls.crt"
        change_mode = "restart"
        data        = <<EOH
{{ with secret "${kv_path}" }}{{ .Data.data.tls_cert }}{{ end }}
EOH
      }
      template {
        destination = "secrets/tls.key"
        change_mode = "restart"
        data        = <<EOH
{{ with secret "${kv_path}" }}{{ .Data.data.tls_key }}{{ end }}
EOH
      }
%{ if enable_project_creator ~}
      # Nomad JWKS CA (multi-line PEM → file) the creator installs into each new
      # project namespace's jwt-nomad config.
      template {
        destination = "secrets/nomad_ca.pem"
        change_mode = "restart"
        data        = <<EOH
${nomad_ca_pem}
EOH
      }
%{ endif ~}
%{ if enable_platform_admin ~}
      # Platform Admin onboarding plane: resolve the MCP + LLM gateway base URLs from
      # Nomad-native service discovery — the gateways register provider="nomad" services
      # "mcp-gateway" / "llm-gateway", both in this job's "infra" namespace. This drops
      # the loopback co-location requirement (the portal may run on any node). env=true
      # publishes them as PORTAL_*_GATEWAY_ADDR; change_mode=restart re-reads a gateway
      # that moved node/port. Consul DNS for fully dynamic resolution is a roadmap item.
      template {
        destination = "secrets/gateways.env"
        env         = true
        change_mode = "restart"
        data        = <<EOH
{{ range nomadService "mcp-gateway" }}
PORTAL_MCP_GATEWAY_ADDR=http://{{ .Address }}:{{ .Port }}
{{ end }}
{{ range nomadService "llm-gateway" }}
PORTAL_LLM_GATEWAY_ADDR=http://{{ .Address }}:{{ .Port }}
{{ end }}
EOH
      }
%{ endif ~}

      env {
        PORTAL_LISTEN_ADDR             = ":${port}"
        PORTAL_OIDC_ISSUER             = "${oidc_issuer}"
        PORTAL_OIDC_CLIENT_ID          = "${oidc_client_id}"
        PORTAL_OIDC_REDIRECT_URL       = "${oidc_redirect_url}"
        PORTAL_BOUNDARY_ADDR           = "${boundary_addr}"
        PORTAL_BOUNDARY_PUBLIC_ADDR    = "${boundary_public_addr}"
        PORTAL_BOUNDARY_AUTH_METHOD_ID = "${boundary_auth_method_id}"
        PORTAL_NOMAD_ADDR              = "${nomad_addr}"
        PORTAL_VAULT_ADDR              = "${vault_addr}"
        PORTAL_VAULT_KV_MOUNT          = "${kv_mount}"
        # WIF token + TLS files Nomad writes into the task secrets dir.
        PORTAL_VAULT_TOKEN_FILE = "$${NOMAD_SECRETS_DIR}/vault_token"
        PORTAL_TLS_CERT_FILE    = "$${NOMAD_SECRETS_DIR}/tls.crt"
        PORTAL_TLS_KEY_FILE     = "$${NOMAD_SECRETS_DIR}/tls.key"
        PORTAL_SECURE_COOKIES   = "true"
        # HashiStack is reached over loopback with self-signed certs — verification
        # is skipped exactly as the node's own Nomad→Vault integration does.
        PORTAL_TLS_SKIP_VERIFY = "true"
        # Remote backend: it is not on the developer's machine, so disable the
        # local SSH-config "Open in IDE" writes (the secured-ws:// helper drives that).
        PORTAL_SSH_CONFIG_PATH = ""
        PORTAL_LOG_LEVEL       = "info"
%{ if enable_platform_admin ~}
        # Platform Admin onboarding plane. Gateway base URLs (PORTAL_MCP_GATEWAY_ADDR /
        # PORTAL_LLM_GATEWAY_ADDR) come from the Nomad service-discovery template block
        # above — not co-location — so they are not set here.
        PORTAL_MCP_NAMESPACE      = "${mcp_namespace}"
        PORTAL_AGENT_NODE_POOL    = "${agent_node_pool}"
        PORTAL_MCP_JOB_VAULT_ROLE = "${mcp_job_vault_role}"
        # Project-deploy plane: broker a namespace-native provisioner token via the
        # second workload identity above. Role/mount match terraform/project/portal-provisioner.tf.
        PORTAL_PROVISIONER_JWT_PATH   = "$${NOMAD_SECRETS_DIR}/nomad_vault_provisioner.jwt"
        PORTAL_PROVISIONER_ROLE       = "portal-provisioner"
        PORTAL_PROVISIONER_AUTH_MOUNT = "jwt-nomad"
%{ endif ~}
%{ if enable_project_creator ~}
        # Project-create plane: broker a short-TTL creator token via the third
        # workload identity, plus the coordinates baked into new project descriptors
        # and child-namespace auth. Role/aud match the project_creator role above.
        PORTAL_CREATOR_JWT_PATH             = "$${NOMAD_SECRETS_DIR}/nomad_vault_creator.jwt"
        PORTAL_CREATOR_ROLE                 = "project-creator"
        PORTAL_CREATOR_AUTH_MOUNT           = "jwt-nomad"
        PORTAL_NOMAD_JWKS_URL               = "${nomad_jwks_url}"
        PORTAL_NOMAD_CA_PEM_FILE            = "$${NOMAD_SECRETS_DIR}/nomad_ca.pem"
        PORTAL_NOMAD_OIDC_AUTH_METHOD       = "${nomad_oidc_auth_method}"
        PORTAL_BOUNDARY_ORG_SCOPE_ID        = "${boundary_org_scope_id}"
        PORTAL_BOUNDARY_OIDC_AUTH_METHOD_ID = "${boundary_oidc_method_id}"
        PORTAL_INSTANCE_PRIVATE_IP          = "${instance_private_ip}"
%{ endif ~}
      }

      service {
        name     = "developer-portal"
        provider = "nomad"
        port     = "https"
        check {
          type            = "http"
          protocol        = "https"
          path            = "/health"
          interval        = "10s"
          timeout         = "2s"
          tls_skip_verify = true
        }
      }

      resources {
        cpu    = 500
        memory = 512
      }
    }
  }
}
